# Ad-hoc PowerShell scripts used for one-off live API verification during
# development (see task 24 notes) -- always deleted after use, but ignore
# the pattern in case one is ever left behind.
.tmp-*.ps1

# Local desktop-launch shortcut for the built app (points at an absolute
# path on this machine, not portable -- never commit).
*.lnk

